import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    width: 430px;
    height: 360px;
    title: "LastKey Settings";

    in-out property <string> vertical-first: "W";
    in-out property <string> vertical-second: "S";
    in-out property <string> horizontal-first: "A";
    in-out property <string> horizontal-second: "D";
    in-out property <string> status: "";

    callback capture-key(int);
    callback apply-settings();
    callback cancel-settings();
    callback restore-defaults();

    VerticalBox {
        padding: 20px;
        spacing: 12px;

        Text {
            text: "Key Mapping";
            font-size: 22px;
            font-weight: 700;
        }
        Text { text: "Choose four unique physical keyboard keys."; color: #666; }

        Text { text: "Vertical"; font-weight: 600; }
        HorizontalBox {
            spacing: 8px;
            Button { text: root.vertical-first; clicked => { root.capture-key(0); } }
            Text { text: "↕"; vertical-alignment: center; horizontal-alignment: center; }
            Button { text: root.vertical-second; clicked => { root.capture-key(1); } }
        }

        Text { text: "Horizontal"; font-weight: 600; }
        HorizontalBox {
            spacing: 8px;
            Button { text: root.horizontal-first; clicked => { root.capture-key(2); } }
            Text { text: "↔"; vertical-alignment: center; horizontal-alignment: center; }
            Button { text: root.horizontal-second; clicked => { root.capture-key(3); } }
        }

        Text { text: root.status; color: #a33; }

        HorizontalBox {
            spacing: 8px;
            Button { text: "Restore Defaults"; clicked => { root.restore-defaults(); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Cancel"; clicked => { root.cancel-settings(); } }
            Button { text: "Apply"; primary: true; clicked => { root.apply-settings(); } }
        }
    }
}
